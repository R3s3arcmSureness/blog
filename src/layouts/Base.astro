---
import '../styles/global.css';
import { SITE, NAV, BASE, withBase } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const desc = description ?? SITE.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 去掉 base 前缀，得到站点内部的路由路径，用于导航高亮判断
const routePath = Astro.url.pathname.replace(new RegExp(`^${BASE}`), '') || '/';
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <div class="progress" id="progress"></div>

    <div class="bg-canvas" aria-hidden="true">
      <div class="bg-grid"></div>
      <div class="bg-glow bg-glow--1"></div>
      <div class="bg-glow bg-glow--2"></div>
      <div class="bg-glow bg-glow--3"></div>
      <div class="bg-noise"></div>
    </div>

    <header class="site-header">
      <div class="container site-header__inner">
        <a href={withBase('/')} class="logo">
          <span class="logo__mark">R3</span>
          <span>{SITE.title}</span>
        </a>
        <nav class="nav">
          {
            NAV.map((item) => (
              <a
                href={withBase(item.href)}
                aria-current={
                  item.href === '/'
                    ? routePath === '/' && 'page'
                    : routePath === item.href || routePath.startsWith(`${item.href}/`)
                      ? 'page'
                      : undefined
                }
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div>
          <a href={withBase('/')} class="logo" style="margin-bottom:10px">
            <span class="logo__mark">R3</span>
            <span>{SITE.title}</span>
          </a>
          <div class="site-footer__copy">© {new Date().getFullYear()} {SITE.author} · Built with Astro</div>
        </div>
        <div class="site-footer__links">
          <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>
          <a href={withBase('/posts')}>文章</a>
          <a href={withBase('/projects')}>项目</a>
          <a href={withBase('/about')}>关于</a>
        </div>
      </div>
    </footer>

    <script>
      // ---------- 滚动进度条 ----------
      const bar = document.getElementById('progress');
      const onScroll = () => {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        if (bar) bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
      };
      document.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // ---------- 滚动进场动画 ----------
      // 设计要点：绝不因为观察器没触发而让内容永久隐形（隐形 = 点不了）。
      // 三层保障：① 首屏元素立即可见 ② 观察器负责后续元素 ③ 定时兜底全量显示。
      const revealAll = (el: Element) => el.classList.add('is-visible');

      const initReveal = () => {
        const items = Array.from(document.querySelectorAll('.reveal'));
        if (!items.length) return;

        // ① 首屏（已在视口内）直接显示，不等观察器
        const vh = window.innerHeight || document.documentElement.clientHeight;
        items.forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top < vh * 0.92 && r.bottom > 0) revealAll(el);
        });

        // ② 观察器处理滚动到才出现的元素
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => {
                if (e.isIntersecting) {
                  revealAll(e.target);
                  io.unobserve(e.target);
                }
              });
            },
            { threshold: 0.05, rootMargin: '0px 0px -8% 0px' }
          );
          items.forEach((el) => {
            if (!el.classList.contains('is-visible')) io.observe(el);
          });
        }

        // ③ 兜底：1.2s 后仍未显示的一律显示，保证没有隐形可点区域
        setTimeout(() => {
          document.querySelectorAll('.reveal:not(.is-visible)').forEach(revealAll);
        }, 1200);
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReveal);
      } else {
        initReveal();
      }
      window.addEventListener('load', initReveal);

      // ---------- 卡片光标跟随 ----------
      document.querySelectorAll('.card').forEach((card) => {
        card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', e.clientX - r.left + 'px');
          card.style.setProperty('--my', e.clientY - r.top + 'px');
        });
      });

      // ---------- 首屏打字机 ----------
      const tw = document.getElementById('typewriter');
      if (tw) {
        const phrases = JSON.parse(tw.dataset.phrases || '[]');
        if (phrases.length) {
          let p = 0,
            c = 0,
            del = false;
          const tick = () => {
            const cur = phrases[p] || '';
            c += del ? -1 : 1;
            tw.textContent = cur.slice(0, c);
            let delay = del ? 45 : 78;
            if (!del && c === cur.length) {
              delay = 1900;
              del = true;
            } else if (del && c === 0) {
              del = false;
              p = (p + 1) % phrases.length;
              delay = 320;
            }
            setTimeout(tick, delay);
          };
          tick();
        }
      }
    </script>
  </body>
</html>
