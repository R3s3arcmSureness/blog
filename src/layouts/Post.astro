---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';
import { SITE, withBase } from '../config';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags = [], readingTime } = post.data;
---

<Base title={title} description={description}>
  <article class="container section" style="padding-top:56px">
    <header style="max-width:760px;margin-bottom:38px">
      <a href={withBase('/posts')} class="mono" style="color:var(--text-faint);font-size:.86rem">
        ← 返回文章列表
      </a>
      <h1 style="margin:18px 0 14px">{title}</h1>
      <div class="card__meta" style="margin-bottom:18px">
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {readingTime && (
          <>
            <span>·</span>
            <span>{readingTime}</span>
          </>
        )}
        {tags.length > 0 && (
          <>
            <span>·</span>
            <span>{tags.length} 个标签</span>
          </>
        )}
      </div>
      {tags.length > 0 && (
        <div class="tag-row">
          {tags.map((t) => (
            <span class="chip chip--accent">{t}</span>
          ))}
        </div>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    <div
      style="margin-top:52px;padding:22px 26px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between"
    >
      <div>
        <div style="font-weight:600;margin-bottom:3px">继续阅读</div>
        <div class="muted" style="font-size:.9rem">更多内容在文章列表里。</div>
      </div>
      <div style="display:flex;gap:10px">
        <a class="btn btn--ghost" href={SITE.github} target="_blank" rel="noopener">
          GitHub
        </a>
        <a class="btn btn--primary" href={withBase('/posts')}>更多文章</a>
      </div>
    </div>
  </article>
</Base>
