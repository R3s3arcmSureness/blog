---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags = [], readingTime } = post.data;
---

<Base title={title} description={description}>
  <article class="container section" style="padding-top:56px">
    <header style="max-width:760px;margin-bottom:38px">
      <a href="/blog" class="mono" style="color:var(--text-faint);font-size:.86rem">
        ← 返回文章列表
      </a>
      <h1 style="margin:18px 0 14px">{title}</h1>
      <div class="card__meta" style="margin-bottom:18px">
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <span>·</span>
        <span>{readingTime}</span>
        <span>·</span>
        <span>{tags.length} 个标签</span>
      </div>
      <div class="tag-row">
        {tags.map((t) => <span class="chip chip--accent">{t}</span>)}
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>

    <div
      style="margin-top:52px;padding:22px 26px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between"
    >
      <div>
        <div style="font-weight:600;margin-bottom:3px">喜欢这篇文章？</div>
        <div class="muted" style="font-size:.9rem">在 GitHub 上给个 Star，或来评论区聊聊。</div>
      </div>
      <div style="display:flex;gap:10px">
        <a class="btn btn--ghost" href="https://github.com/R3s3arcmSureness" target="_blank" rel="noopener">
          GitHub
        </a>
        <a class="btn btn--primary" href="/blog">更多文章</a>
      </div>
    </div>
  </article>
</Base>
