---
import Base from '../layouts/Base.astro';
import { REPOS, SITE } from '../config';
---

<Base title="项目" description="开源项目列表">
  <section class="container section" style="padding-top:56px">
    <div class="section-head reveal">
      <span class="section-head__eyebrow">// open source</span>
      <h1>项目</h1>
      <p class="section-head__desc">数据实时取自 GitHub API。</p>
    </div>

    <div class="grid grid--2">
      {
        REPOS.map((r) => (
          <a class="card reveal" href={r.href} target="_blank" rel="noopener">
            <div class="card__title">
              <span style={`color:${r.accent};font-family:var(--font-mono);font-size:.9rem`}>◆</span>
              {r.name}
              <span class="card__arrow" style="color:var(--text-faint)">↗</span>
            </div>
            {r.desc ? (
              <p class="card__desc">{r.desc}</p>
            ) : (
              <p class="card__desc" style="opacity:.5;font-style:italic">
                暂未填写项目描述
              </p>
            )}
            <div class="card__meta">
              {r.lang && <span class="chip">{r.lang}</span>}
              {r.stars > 0 && <span class="chip chip--accent">★ {r.stars}</span>}
              <span style="margin-left:auto;color:var(--text-faint)">github.com</span>
            </div>
          </a>
        ))
      }
    </div>

    <div style="margin-top:36px" class="reveal">
      <a class="btn btn--ghost" href={SITE.github} target="_blank" rel="noopener">
        在 GitHub 上查看全部 →
      </a>
    </div>
  </section>
</Base>
