---
import Base from '../layouts/Base.astro';
import { SITE, REPOS, withBase } from '../config';

const langs = [...new Set(REPOS.map((r) => r.lang).filter(Boolean))];
---

<Base title="关于" description="关于我">
  <section class="container section" style="padding-top:56px">
    <div class="section-head reveal">
      <span class="section-head__eyebrow">// about</span>
      <h1>关于</h1>
    </div>

    <div class="prose reveal">
      <p>
        我是 <strong>{SITE.author}</strong>。这个站点用来存放我的开源项目与技术笔记。
      </p>
      <p>
        想了解我在做什么，直接看
        <a href={withBase('/posts')}>文章</a> 和 <a href={withBase('/projects')}>项目</a>
        两个页面就够了——剩下的等写出来再说。
      </p>
    </div>

    <div class="grid grid--2" style="margin-top:44px">
      <div class="card reveal">
        <div class="card__title">
          <span class="mono" style="color:var(--accent)">01</span>技术栈
        </div>
        <div class="card__meta" style="margin-top:12px">
          {langs.map((l) => <span class="chip">{l}</span>)}
        </div>
      </div>

      <div class="card reveal">
        <div class="card__title">
          <span class="mono" style="color:var(--accent-2)">02</span>联系
        </div>
        <div class="card__meta" style="margin-top:12px">
          <a class="chip chip--accent" href={SITE.github} target="_blank" rel="noopener">
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
